{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-kaiju",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{"name":"BATTLE_ROOMS","class_name":"BattleRoom"}]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["BattleRoom"]}]
}
